root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.{py,html,css,js,json,md,yml,yaml}]
end_of_line = lf

[*.{ps1,bat,cmd}]
end_of_line = crlf

[*.py]
indent_style = space
indent_size = 4

[*.{html,css,js,json,yml,yaml}]
indent_style = space
indent_size = 2
